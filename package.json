{
  "name": "@interrogate/tools",
  "private": true,
  "scripts": {
    "build": "lerna run build",
    "check-dependencies": "lerna run check-dependencies",
    "commitlint": "commitlint --edit",
    "deep-clean": "git clean -fdX -e !ssl/*",
    "format": "lerna run format",
    "generate-cert": "npx --yes mkcert create-ca && npx --yes mkcert create-cert --key ssl/server.key --cert ssl/server.crt && rm ca.key ca.cert",
    "lerna": "lerna",
    "lint": "lerna run lint",
    "postinstall": "patch-package",
    "prepare": "husky",
    "test": "lerna run test",
    "test-coverage": "lcov-result-merger 'libs/*/coverage/lcov.info' lcov.info --prepend-source-files --prepend-path-fix '../'",
    "typecheck": "lerna run typecheck"
  },
  "workspaces": [
    "apps/*",
    "libs/*"
  ],
  "overrides": {
    "glob": "13.0.6",
    "uuid": "14.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "21.0.1",
    "@commitlint/config-conventional": "21.0.1",
    "@commitlint/config-workspace-scopes": "21.0.1",
    "@eslint/js": "10.0.1",
    "@tsconfig/vite-react": "7.0.2",
    "@types/node": "25.7.0",
    "@vitest/coverage-v8": "4.1.6",
    "@vitest/ui": "4.1.6",
    "dependency-cruiser": "17.4.0",
    "esbuild": "0.28.0",
    "eslint": "10.3.0",
    "eslint-config-prettier": "10.1.8",
    "glob": "13.0.6",
    "husky": "9.1.7",
    "jiti": "2.7.0",
    "lcov-result-merger": "6.0.0",
    "lerna": "9.0.7",
    "patch-package": "8.0.1",
    "prettier": "3.8.3",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "rehype": "13.0.2",
    "rehype-stringify": "10.0.1",
    "remark": "15.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "tsx": "4.21.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.59.3",
    "unified": "11.0.5",
    "uuid": "14.0.0",
    "vite": "8.0.12",
    "vitest": "4.1.6",
    "webpack-dev-server": "5.2.4"
  }
}
