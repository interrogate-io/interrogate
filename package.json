{
  "name": "@interrogate/tools",
  "private": true,
  "scripts": {
    "build": "lerna run build",
    "check-dependencies": "lerna run check-dependencies",
    "commitlint": "commitlint --edit",
    "deep-clean": "git clean -fdX -e !ssl/*",
    "format": "lerna run format",
    "generate-cert": "npx --yes mkcert create-ca && npx --yes mkcert create-cert --key ssl/server.key --cert ssl/server.crt && rm ca.key ca.cert",
    "lerna": "lerna",
    "lint": "lerna run lint",
    "postinstall": "patch-package",
    "prepare": "husky",
    "test": "lerna run test",
    "test-coverage": "lcov-result-merger 'libs/*/coverage/lcov.info' lcov.info --prepend-source-files --prepend-path-fix '../'",
    "typecheck": "lerna run typecheck"
  },
  "workspaces": [
    "apps/*",
    "libs/*"
  ],
  "overrides": {
    "form-data": "4.0.6",
    "glob": "13.0.6",
    "http-proxy-middleware": "4.2.0",
    "js-yaml": "5.2.1",
    "tar": "7.5.19",
    "test-exclude": "8.0.0",
    "tmp": "0.2.7",
    "uuid": "14.0.1"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@commitlint/config-workspace-scopes": "21.2.0",
    "@eslint/js": "10.0.1",
    "@tsconfig/vite-react": "8.0.6",
    "@types/node": "26.1.1",
    "@vitest/coverage-v8": "4.1.10",
    "@vitest/ui": "4.1.10",
    "dependency-cruiser": "18.0.0",
    "esbuild": "0.28.1",
    "eslint": "10.6.0",
    "eslint-config-prettier": "10.1.8",
    "form-data": "4.0.6",
    "glob": "13.0.6",
    "http-proxy-middleware": "4.2.0",
    "husky": "9.1.7",
    "jiti": "2.7.0",
    "js-yaml": "5.2.1",
    "lcov-result-merger": "6.0.0",
    "lerna": "9.0.7",
    "patch-package": "8.0.1",
    "prettier": "3.9.4",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "rehype": "13.0.2",
    "rehype-stringify": "10.0.1",
    "remark": "15.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "tar": "7.5.19",
    "test-exclude": "8.0.0",
    "tmp": "0.2.7",
    "tsx": "4.23.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.63.0",
    "unified": "11.0.5",
    "uuid": "14.0.1",
    "vite": "8.1.3",
    "vitest": "4.1.10",
    "webpack-dev-server": "6.0.0"
  },
  "allowScripts": {
    "@swc/core@1.15.24": true,
    "core-js@3.45.1": true,
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true,
    "nx@22.7.5": true,
    "unrs-resolver@1.11.1": true
  }
}
