{
  "name": "@interrogate/tools",
  "private": true,
  "scripts": {
    "build": "lerna run build",
    "check-dependencies": "lerna run check-dependencies",
    "commitlint": "commitlint --edit",
    "deep-clean": "git clean -fdX -e !ssl/*",
    "format": "lerna run format",
    "generate-cert": "npx --yes mkcert create-ca && npx --yes mkcert create-cert --key ssl/server.key --cert ssl/server.crt && rm ca.key ca.cert",
    "lerna": "lerna",
    "lint": "lerna run lint",
    "prepare": "husky",
    "test": "lerna run test",
    "test-coverage": "lcov-result-merger 'libs/*/coverage/lcov.info' lcov.info --prepend-source-files --prepend-path-fix '../'",
    "typecheck": "lerna run typecheck"
  },
  "workspaces": [
    "apps/*",
    "libs/*"
  ],
  "overrides": {
    "webpack-dev-server": "5.2.2"
  },
  "devDependencies": {
    "@commitlint/cli": "20.1.0",
    "@commitlint/config-conventional": "20.0.0",
    "@commitlint/config-workspace-scopes": "20.0.0",
    "@eslint/js": "9.37.0",
    "@tsconfig/vite-react": "7.0.1",
    "@types/node": "24.7.2",
    "@vitest/coverage-v8": "3.2.4",
    "@vitest/ui": "3.2.4",
    "dependency-cruiser": "17.0.2",
    "esbuild": "0.25.10",
    "eslint": "9.37.0",
    "eslint-config-prettier": "10.1.8",
    "husky": "9.1.7",
    "jiti": "2.6.1",
    "lcov-result-merger": "5.0.1",
    "lerna": "9.0.0",
    "prettier": "3.6.2",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "rehype": "13.0.2",
    "rehype-stringify": "10.0.1",
    "remark": "15.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.0",
    "unified": "11.0.5",
    "vite": "7.1.9",
    "vitest": "3.2.4",
    "webpack-dev-server": "5.2.2"
  }
}
